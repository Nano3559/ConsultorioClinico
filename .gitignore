# =====================================================================
# ConsultorioClínico — .gitignore
# Regla de oro: NUNCA subir secretos (.env, llaves de servicio, keystores).
# =====================================================================

# --- Entorno y secretos (NUNCA subir) --------------------------------
.env
.env.*
!**/.env.example
service-account.json
**/service-account.json
firebase-migrator-key.json
**/firebase-migrator-key.json
*.jks
frontend/android/key.properties
*.pem
*.key
secrets/

# --- Flutter / Dart ---------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.iml
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/ephemeral/

# --- Android ----------------------------------------------------------
frontend/android/.gradle/
frontend/android/local.properties
*.keystore
!gradle/wrapper/gradle-wrapper.jar

# --- Node.js ----------------------------------------------------------
node_modules/
dist/
coverage/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- IDE / editores ---------------------------------------------------
.idea/
.vscode/
*.swp

# --- Firebase ---------------------------------------------------------
.firebase/
firebase-debug.log*
ui-debug.log*

# --- Vercel -----------------------------------------------------------
.vercel

# --- Sistema operativo ------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Logs y temporales ------------------------------------------------
*.log
tmp/
temp/
