<%- include('partials/header') %>

<section class="page-header bg-primary text-white py-5 mt-5">
  <div class="container">
    <h1 class="display-5 fw-bold">Nuestros Servicios</h1>
    <p class="lead opacity-75">Amplia gama de servicios médicos para tu bienestar</p>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <% servicios.forEach(function(s) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm service-card">
            <div class="card-body p-4">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle bg-success bg-opacity-10 p-3 rounded-circle me-3">
                  <i class="bi bi-check-circle text-success fs-4"></i>
                </div>
                <div>
                  <h5 class="fw-bold mb-0"><%= s.nombre %></h5>
                  <span class="text-primary fw-semibold"><%= s.precio %></span>
                </div>
              </div>
              <p class="text-muted mb-3"><%= s.descripcion %></p>
              <a href="/cita" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-calendar-plus me-1"></i>Agendar
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
