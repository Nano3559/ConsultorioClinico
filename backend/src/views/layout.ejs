<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MediCore - Consultorio Clínico</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">
        <i class="bi bi-hospital me-2"></i>MediCore
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Inicio</a></li>
          <li class="nav-item"><a class="nav-link" href="/nosotros">Nosotros</a></li>
          <li class="nav-item"><a class="nav-link" href="/especialidades">Especialidades</a></li>
          <li class="nav-item"><a class="nav-link" href="/medicos">Médicos</a></li>
          <li class="nav-item"><a class="nav-link" href="/servicios">Servicios</a></li>
          <li class="nav-item"><a class="nav-link" href="/horarios">Horarios</a></li>
          <li class="nav-item"><a class="nav-link" href="/contacto">Contacto</a></li>
          <li class="nav-item ms-lg-2">
            <a class="btn btn-light btn-sm px-3" href="/cita">
              <i class="bi bi-calendar-plus me-1"></i>Solicitar Cita
            </a>
          </li>
          <li class="nav-item ms-lg-2">
            <a class="nav-link" href="/login">
              <i class="bi bi-person-circle"></i>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <main class="main-content">
    <%- body %>
  </main>

  <footer class="bg-dark text-white py-5">
    <div class="container">
      <div class="row g-4">
        <div class="col-lg-4">
          <h5 class="fw-bold mb-3"><i class="bi bi-hospital me-2"></i>MediCore</h5>
          <p class="text-light opacity-75">Tu salud es nuestra prioridad. Atención médica de calidad con profesionales expertos.</p>
          <div class="d-flex gap-3 mt-3">
            <a href="<%= contacto.redes.facebook %>" class="text-white fs-5"><i class="bi bi-facebook"></i></a>
            <a href="<%= contacto.redes.instagram %>" class="text-white fs-5"><i class="bi bi-instagram"></i></a>
            <a href="<%= contacto.redes.twitter %>" class="text-white fs-5"><i class="bi bi-twitter"></i></a>
          </div>
        </div>
        <div class="col-lg-2">
          <h6 class="fw-bold mb-3">Enlaces</h6>
          <ul class="list-unstyled">
            <li class="mb-2"><a href="/" class="text-light text-decoration-none opacity-75">Inicio</a></li>
            <li class="mb-2"><a href="/nosotros" class="text-light text-decoration-none opacity-75">Nosotros</a></li>
            <li class="mb-2"><a href="/especialidades" class="text-light text-decoration-none opacity-75">Especialidades</a></li>
            <li class="mb-2"><a href="/medicos" class="text-light text-decoration-none opacity-75">Médicos</a></li>
          </ul>
        </div>
        <div class="col-lg-3">
          <h6 class="fw-bold mb-3">Contacto</h6>
          <ul class="list-unstyled text-light opacity-75">
            <li class="mb-2"><i class="bi bi-geo-alt me-2"></i><%= contacto.direccion %></li>
            <li class="mb-2"><i class="bi bi-telephone me-2"></i><%= contacto.telefono %></li>
            <li class="mb-2"><i class="bi bi-envelope me-2"></i><%= contacto.email %></li>
            <li class="mb-2"><i class="bi bi-clock me-2"></i><%= contacto.horariosGenerales %></li>
          </ul>
        </div>
        <div class="col-lg-3">
          <h6 class="fw-bold mb-3">WhatsApp</h6>
          <a href="https://wa.me/<%= contacto.whatsapp.replace(/[^0-9]/g, '') %>" class="btn btn-success w-100" target="_blank">
            <i class="bi bi-whatsapp me-2"></i>Chatea con nosotros
          </a>
        </div>
      </div>
      <hr class="my-4 border-secondary">
      <div class="text-center text-light opacity-50">
        <small>&copy; 2026 MediCore. Todos los derechos reservados.</small>
      </div>
    </div>
  </footer>

  <a href="https://wa.me/<%= contacto.whatsapp.replace(/[^0-9]/g, '') %>" class="whatsapp-float" target="_blank">
    <i class="bi bi-whatsapp"></i>
  </a>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
