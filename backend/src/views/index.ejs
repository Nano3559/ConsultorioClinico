<%- include('partials/header') %>

<section class="hero-section d-flex align-items-center">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h1 class="display-4 fw-bold text-primary">Tu salud en buenas manos</h1>
        <p class="lead text-muted my-4">En MediCore contamos con los mejores profesionales médicos y tecnología de vanguardia para brindarte la mejor atención.</p>
        <div class="d-flex gap-3 flex-wrap">
          <a href="/cita" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-calendar-plus me-2"></i>Solicitar Cita
          </a>
          <a href="/medicos" class="btn btn-outline-primary btn-lg px-4">
            <i class="bi bi-people me-2"></i>Ver Médicos
          </a>
        </div>
      </div>
      <div class="col-lg-6 text-center mt-5 mt-lg-0">
        <div class="hero-image">
          <i class="bi bi-hospital text-primary" style="font-size: 15rem; opacity: 0.2;"></i>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5 bg-light">
  <div class="container">
    <div class="row g-4 text-center">
      <div class="col-md-3">
        <div class="stat-card p-4 bg-white rounded shadow-sm">
          <i class="bi bi-people text-primary fs-1"></i>
          <h3 class="fw-bold mt-3">6+</h3>
          <p class="text-muted mb-0">Especialidades</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card p-4 bg-white rounded shadow-sm">
          <i class="bi bi-person-badge text-primary fs-1"></i>
          <h3 class="fw-bold mt-3">6+</h3>
          <p class="text-muted mb-0">Médicos Expertos</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card p-4 bg-white rounded shadow-sm">
          <i class="bi bi-heart text-primary fs-1"></i>
          <h3 class="fw-bold mt-3">15+</h3>
          <p class="text-muted mb-0">Años de Experiencia</p>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-card p-4 bg-white rounded shadow-sm">
          <i class="bi bi-emoji-smile text-primary fs-1"></i>
          <h3 class="fw-bold mt-3">5000+</h3>
          <p class="text-muted mb-0">Pacientes Felices</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <h2 class="text-center fw-bold mb-2">Nuestras Especialidades</h2>
    <p class="text-center text-muted mb-5">Contamos con los mejores profesionales en cada área</p>
    <div class="row g-4">
      <% especialidades.forEach(function(e) { %>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
              <i class="bi <%= e.icono %> text-primary fs-1 mb-3"></i>
              <h5 class="fw-bold"><%= e.nombre %></h5>
              <p class="text-muted"><%= e.descripcion.substring(0, 100) %>...</p>
              <p class="text-primary fw-semibold"><i class="bi bi-person me-1"></i><%= e.medico %></p>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-4">
      <a href="/especialidades" class="btn btn-outline-primary">Ver todas las especialidades</a>
    </div>
  </div>
</section>

<section class="py-5 bg-primary text-white">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <h2 class="fw-bold">¿Por qué elegirnos?</h2>
        <p class="opacity-75">Nos distinguimos por nuestro compromiso con la excelencia médica y la atención personalizada.</p>
      </div>
      <div class="col-lg-6">
        <div class="row g-3">
          <div class="col-6">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle-fill me-2 fs-4"></i>
              <span>Profesionales certificados</span>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle-fill me-2 fs-4"></i>
              <span>Tecnología moderna</span>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle-fill me-2 fs-4"></i>
              <span>Atención personalizada</span>
            </div>
          </div>
          <div class="col-6">
            <div class="d-flex align-items-center">
              <i class="bi bi-check-circle-fill me-2 fs-4"></i>
              <span>Horarios flexibles</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <h2 class="text-center fw-bold mb-2">Nuestros Médicos</h2>
    <p class="text-center text-muted mb-5">Conoce a nuestro equipo de profesionales</p>
    <div class="row g-4">
      <% medicos.forEach(function(m) { %>
        <div class="col-md-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body text-center p-4">
              <div class="doctor-avatar mx-auto mb-3">
                <i class="bi bi-person-circle text-primary"></i>
              </div>
              <h5 class="fw-bold mb-1"><%= m.nombre %></h5>
              <p class="text-primary mb-2"><%= m.especialidad %></p>
              <p class="text-muted small mb-3"><%= m.descripcion.substring(0, 80) %>...</p>
              <div class="d-flex justify-content-center gap-2">
                <span class="badge bg-light text-dark"><i class="bi bi-clock me-1"></i><%= m.experiencia %></span>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
    <div class="text-center mt-4">
      <a href="/medicos" class="btn btn-outline-primary">Ver todos los médicos</a>
    </div>
  </div>
</section>

<section class="py-5 bg-light">
  <div class="container text-center">
    <h2 class="fw-bold mb-3">¿Necesitas una cita?</h2>
    <p class="text-muted mb-4">No esperes más, agenda tu cita hoy mismo y cuida tu salud.</p>
    <a href="/cita" class="btn btn-primary btn-lg px-5">
      <i class="bi bi-calendar-plus me-2"></i>Solicitar Cita Ahora
    </a>
  </div>
</section>

<%- include('partials/footer') %>
