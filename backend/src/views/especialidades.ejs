<%- include('partials/header') %>

<section class="page-header bg-primary text-white py-5 mt-5">
  <div class="container">
    <h1 class="display-5 fw-bold">Especialidades</h1>
    <p class="lead opacity-75">Contamos con las principales especialidades médicas</p>
  </div>
</section>

<section class="py-5">
  <div class="container">
    <div class="row g-4">
      <% especialidades.forEach(function(e) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm specialty-card">
            <div class="card-body p-4">
              <div class="d-flex align-items-center mb-3">
                <div class="icon-circle bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                  <i class="bi <%= e.icono %> text-primary fs-3"></i>
                </div>
                <h5 class="fw-bold mb-0"><%= e.nombre %></h5>
              </div>
              <p class="text-muted mb-3"><%= e.descripcion %></p>
              <div class="mb-3">
                <p class="mb-1"><i class="bi bi-person me-2 text-primary"></i><strong><%= e.medico %></strong></p>
                <p class="mb-0 small text-muted"><i class="bi bi-clock me-2"></i><%= e.horarios %></p>
              </div>
              <a href="/cita" class="btn btn-primary w-100">
                <i class="bi bi-calendar-plus me-2"></i>Solicitar Cita
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
