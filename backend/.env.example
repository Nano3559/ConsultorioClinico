# =====================================================================
# ConsultorioClínico — backend/.env.example
# Copia este archivo a backend/.env y completa los valores reales.
# NUNCA subas el .env real al repositorio.
# =====================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- JWT ---
# JWT_SECRET es OBLIGATORIO en producción (secreto largo y aleatorio).
# En desarrollo, si se omite, se genera uno aleatorio por proceso.
JWT_SECRET=
JWT_EXPIRE=24h

# --- CORS ---
# Orígenes permitidos separados por coma. Ej:
# CORS_ORIGINS=http://localhost:5000,https://consultorioclinico-2026.web.app
# Si queda vacío: peticiones de navegador bloqueadas (solo server-to-server).
CORS_ORIGINS=

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave service_role: SOLO backend, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión directa a Postgres (solo para npm run db:migrate) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Ej: postgresql://postgres:TU_PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# --- Microservicio de visión (Python + FastAPI) ---
# URL base del módulo de reconocimiento facial (backend/vision).
VISION_ENABLED=true
VISION_SERVICE_URL=http://localhost:8000
# Alias opcional (si el microservicio vive en otra URL):
# VISION_PYTHON_SERVICE_URL=http://localhost:8000
# Ruta del modelo LBPH entrenado y del clasificador Haar Cascade, relativas a
# backend/vision/ (el módulo las une a su propio directorio).
VISION_FACE_MODEL=modelo_lbph.yml
VISION_CASCADE_PATH=haarcascade_frontalface_default.xml
# Umbral de confianza LBPH: por debajo se considera "rostro reconocido".
VISION_CONFIDENCE_THRESHOLD=80
# Cuántas muestras captura el kiosko al registrar un rostro nuevo (backend/vision/capture_faces.py).
VISION_CAPTURE_COUNT=20
# Tiempo máximo de espera por llamada HTTP al microservicio (ms) y reintentos.
VISION_TIMEOUT_MS=5000
VISION_RETRIES=3
