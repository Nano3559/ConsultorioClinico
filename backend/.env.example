# =====================================================================
# ConsultorioClínico — backend/.env.example
# Copia este archivo a backend/.env y completa los valores reales.
# NUNCA subas el .env real al repositorio.
# =====================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- JWT ---
# JWT_SECRET es OBLIGATORIO en producción (secreto largo y aleatorio).
# En desarrollo, si se omite, se genera uno aleatorio por proceso.
JWT_SECRET=
JWT_EXPIRE=24h

# --- CORS ---
# Orígenes permitidos separados por coma. Ej:
# CORS_ORIGINS=http://localhost:5000,https://consultorioclinico-2026.web.app
# Si queda vacío: peticiones de navegador bloqueadas (solo server-to-server).
CORS_ORIGINS=

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=https://TU_REF_PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_TU_CLAVE
# Clave service_role: SOLO backend, nunca en el frontend.
# NUNCA escribas el valor real aqui. Va en las variables de entorno de Vercel.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE

# --- Conexión a Postgres (solo para npm run db:migrate) ---
# IMPORTANTE: usa el TRANSACTION POOLER, no la "Direct connection".
# La conexión directa (db.<ref>.supabase.co) es solo IPv6 y varios ISP/DNS
# no la resuelven (error getaddrinfo EAI_AGAIN). El pooler sí tiene IPv4.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# y cambia el selector a "Transaction pooler".
# Ej: postgresql://postgres.<REF_PROYECTO>:TU_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.TU_REF_PROYECTO:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Microservicio de visión (Python + FastAPI, InsightFace) ---
# URL base del módulo de reconocimiento facial (backend/vision).
VISION_ENABLED=true
VISION_SERVICE_URL=http://localhost:8000
# Alias opcional (si el microservicio vive en otra URL):
# VISION_PYTHON_SERVICE_URL=http://localhost:8000
# Pack InsightFace (detección SCRFD + embedding ArcFace 512-d).
VISION_MODEL_PACK=buffalo_s
# Versión lógica: si cambia, el kiosco actualiza sus modelos al sincronizar.
VISION_MODEL_VERSION=buffalo_s_v1
# Umbral de similitud coseno [0-1] para reconocer (punto de partida 0.5).
VISION_SIMILARITY_THRESHOLD=0.5
# Cuántas muestras captura el registro al enrolar un rostro (5 poses x 3).
VISION_CAPTURE_COUNT=15
# Tiempo máximo de espera por llamada HTTP al microservicio (ms) y reintentos.
# 30s por el cold start: la primera inferencia carga modelos (~30-60s).
VISION_TIMEOUT_MS=30000
VISION_RETRIES=3

# --- Kiosco de auto-check-in (seguridad y auditoría, KIO-15/19/20) ---
# Ventana (minutos) en que una verificación facial exitosa del kiosco sigue
# siendo válida para confirmar la cita desde la misma IP sin re-verificar.
KIOSCO_VERIFICATION_WINDOW_MIN=15
# Límite de intentos de verificación facial por IP en la ventana de 15 min.
KIOSCO_VERIFY_RATE_MAX=30
# Límite de confirmaciones de cita por IP en la ventana de 15 min.
KIOSCO_CONFIRM_RATE_MAX=10
# Clave del kiosco Windows (reconocimiento local). El .exe la envia como
# header x-kiosk-key al confirmar. Genera una larga y guardala tambien en la
# app con --dart-define=KIOSK_API_KEY=... (vacia = solo verificacion en nube).
KIOSK_API_KEY=

# --- Vision InsightFace + sincronizacion del kiosco ---
# Pack de modelos: deteccion SCRFD + embedding ArcFace 512-d.
VISION_MODEL_PACK=buffalo_s
# Version logica: si cambia, el kiosco actualiza sus modelos al sincronizar.
VISION_MODEL_VERSION=buffalo_s_v1
# Umbral de similitud coseno [0-1] para reconocer (punto de partida 0.5).
VISION_SIMILARITY_THRESHOLD=0.5
# Minutos entre comprobaciones de sincronizacion (plantillas + modelo).
KIOSCO_SYNC_MINUTOS=15
# Dias de vigencia del registro facial (luego la reserva vuelve a pedir foto).
KIOSCO_REENROLL_DIAS=90
# Bucket privado de Supabase Storage para los packs por persona.
KIOSCO_ROSTRO_BUCKET=rostros
