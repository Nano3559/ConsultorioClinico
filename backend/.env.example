# =====================================================================
# ConsultorioClínico — backend/.env.example
# Copia este archivo a backend/.env y completa los valores reales.
# NUNCA subas el .env real al repositorio.
# =====================================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- JWT ---
# JWT_SECRET es OBLIGATORIO en producción (secreto largo y aleatorio).
# En desarrollo, si se omite, se genera uno aleatorio por proceso.
JWT_SECRET=
JWT_EXPIRE=24h

# --- CORS ---
# Orígenes permitidos separados por coma. Ej:
# CORS_ORIGINS=http://localhost:5000,https://consultorioclinico-2026.web.app
# Si queda vacío: peticiones de navegador bloqueadas (solo server-to-server).
CORS_ORIGINS=

# --- Supabase (PostgreSQL) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave service_role: SOLO backend, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexión directa a Postgres (solo para npm run db:migrate) ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Ej: postgresql://postgres:TU_PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=
