# =====================================================================
# ConsultorioClínico — mail-service/.env.example
# En local copia a mail-service/.env; en Vercel usa Settings -> Environment Variables.
# NUNCA subas el .env real al repositorio.
# =====================================================================

# Correo Gmail desde el que se envían los mensajes
GMAIL_USER=tu.correo@gmail.com

# Contraseña de aplicación de 16 letras (NO tu contraseña normal):
# https://myaccount.google.com/security -> Verificación en dos pasos ->
# Contraseñas de aplicación
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Contenido COMPLETO (JSON) de la clave privada de Firebase Admin
# (firebase-migrator-key.json). La key real está en .gitignore.
FIREBASE_SERVICE_ACCOUNT=

# Remitente visible (opcional)
FROM_EMAIL=ConsultorioClínico <tu.correo@gmail.com>
